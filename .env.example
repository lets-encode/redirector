# Base URL of the separate campaign application (required, no trailing slash).
# This service redirects to ${CAMPAIGN_APP_BASE}/c/<id>, .../new, .../join.
CAMPAIGN_APP_BASE=https://campaigns.example.org

# Path to the SQLite database file. The parent directory is created if needed.
# In Docker, point this at the mounted volume (default: /data/slugs.db).
DB_PATH=./data/slugs.db

# Bearer token for /admin/* — DEV/FALLBACK ONLY. In production, put the
# service behind the institutional reverse-proxy auth (see README) and treat
# this token as defence in depth. If unset, all admin routes return 503.
ADMIN_TOKEN=
